#!/usr/bin/env bash
# user_data do nó SERVER (control-plane) — roda no primeiro boot da EC2.
# k3s server com token compartilhado + --tls-san do IP público E do hostname
# Dynu (se configurado), para o cert ser válido tanto por IP quanto por nome.
# Quando dynu_hostname != "", instala um systemd timer que atualiza o A record
# no Dynu (IP Update Protocol) no boot e a cada 5 min.
set -euo pipefail
exec > /var/log/kubeforge-bootstrap.log 2>&1

echo "==> KubeForge k3s SERVER bootstrap $(date -u)"

# --- IP público atual (IMDSv2) ---------------------------------------------
IMDS_TOKEN="$(curl -s -X PUT 'http://169.254.169.254/latest/api/token' \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
PUBIP="$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/public-ipv4 || true)"
echo "==> IP público: $PUBIP"

DYNU_HOSTNAME='${dynu_hostname}'

# --- SAN extra: hostname Dynu (se configurado) -----------------------------
TLS_SAN_ARGS="--tls-san $PUBIP"
if [ -n "$DYNU_HOSTNAME" ]; then
  TLS_SAN_ARGS="$TLS_SAN_ARGS --tls-san $DYNU_HOSTNAME"
fi

# --- k3s server (idempotente) ----------------------------------------------
if command -v k3s >/dev/null 2>&1 && systemctl is-active --quiet k3s 2>/dev/null; then
  echo "==> k3s server já ativo — nada a fazer."
else
  echo "==> Instalando k3s server (SAN: $TLS_SAN_ARGS)…"
  curl -sfL https://get.k3s.io | \
    K3S_TOKEN='${k3s_token}' \
    INSTALL_K3S_EXEC="server --write-kubeconfig-mode 644 $TLS_SAN_ARGS" \
    sh -
fi

# kubeconfig legível para o usuário ubuntu.
mkdir -p /home/ubuntu/.kube
cp /etc/rancher/k3s/k3s.yaml /home/ubuntu/.kube/config
chown -R ubuntu:ubuntu /home/ubuntu/.kube

# --- Dynu DDNS: script + systemd timer -------------------------------------
if [ -n "$DYNU_HOSTNAME" ]; then
  echo "==> Configurando updater Dynu para $DYNU_HOSTNAME…"

  # Segredo em arquivo root-only (0600). Nota: o user_data é legível na console
  # EC2 — por isso use a IP Update Password DEDICADA do Dynu (revogável), não a
  # senha da conta. Documentado no README (seção DDNS).
  install -m 0600 /dev/null /etc/kubeforge-dynu.env
  cat > /etc/kubeforge-dynu.env <<EOF
DYNU_HOSTNAME=$DYNU_HOSTNAME
DYNU_PASSWORD=${dynu_password}
EOF

  # Script de update: pega o IP público via IMDS e reporta ao Dynu.
  cat > /usr/local/bin/kubeforge-dynu-update.sh <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
. /etc/kubeforge-dynu.env
TOK="$(curl -s -X PUT 'http://169.254.169.254/latest/api/token' \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
IP="$(curl -s -H "X-aws-ec2-metadata-token: $TOK" \
  http://169.254.169.254/latest/meta-data/public-ipv4)"
RESP="$(curl -s "https://api.dynu.com/nic/update?hostname=$DYNU_HOSTNAME&myip=$IP&password=$DYNU_PASSWORD")"
echo "$(date -u) dynu-update ip=$IP resp=$RESP"
SCRIPT
  chmod 0755 /usr/local/bin/kubeforge-dynu-update.sh

  # systemd service (oneshot) + timer (no boot + a cada 5 min).
  cat > /etc/systemd/system/kubeforge-dynu.service <<'UNIT'
[Unit]
Description=KubeForge Dynu DDNS update
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/kubeforge-dynu-update.sh
UNIT

  cat > /etc/systemd/system/kubeforge-dynu.timer <<'UNIT'
[Unit]
Description=KubeForge Dynu DDNS update (boot + a cada 5 min)
[Timer]
OnBootSec=30
OnUnitActiveSec=5min
Persistent=true
[Install]
WantedBy=timers.target
UNIT

  systemctl daemon-reload
  systemctl enable --now kubeforge-dynu.timer
  # Dispara uma vez já no bootstrap para o nome resolver imediatamente.
  /usr/local/bin/kubeforge-dynu-update.sh || true
  echo "==> Dynu timer ativo."
fi

echo "==> SERVER pronto $(date -u)"
